# ============================================
# AlertaSísmica Backend — Variables de entorno
# Copia este archivo como `.env` y completa los valores.
# ============================================

# Entorno: development | test | production
NODE_ENV=development

# Puerto HTTP del backend
PORT=4000

# URL pública del frontend (para CORS y enlaces)
FRONTEND_URL=http://localhost:5173

# Orígenes permitidos para CORS (separados por coma). "*" permite todos.
CORS_ORIGIN=http://localhost:5173

# --- MongoDB (Atlas en producción) ---
# Ej: mongodb+srv://usuario:pass@cluster.mongodb.net/alertasimica
MONGODB_URI=mongodb://localhost:27017/alertasimica

# --- JWT ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Web Push (VAPID) ---
# Generar con: npm run vapid:generate
# O deja vacío: las notificaciones push quedarán desactivadas hasta configurarlas.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: o https: para contacto del operador
VAPID_SUBJECT=mailto:admin@example.com

# --- Fuentes sísmicas ---
# SGC (Servicio Geológico Colombiano). Si queda vacía, la fuente queda
# "misconfigured/disabled" y el sistema sigue con las demás fuentes.
# Formato esperado: GeoJSON FeatureCollection, FeatureServer de ArcGIS o arreglo.
SGC_API_URL=

# USGS Earthquake API (fuente secundaria / fallback)
USGS_API_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson

# --- Motor de alertas (valores iniciales; se pueden cambiar desde /admin) ---
EARTHQUAKE_MIN_MAGNITUDE=4.5
EARTHQUAKE_MAX_DEPTH_KM=200
EARTHQUAKE_ALERT_RADIUS_KM=100
EARTHQUAKE_HIGH_MAGNITUDE_THRESHOLD=5.5
EARTHQUAKE_POLL_INTERVAL_SECONDS=30
EARTHQUAKE_POLL_ENABLED=true
# Fuentes activas por defecto (separadas por coma): sgc, usgs, mock
EARTHQUAKE_SOURCES=sgc,usgs

# --- Demo / Mock ---
# Mock genera eventos simulados claramente marcados como "demo".
EARTHQUAKE_MOCK_ENABLED=false
EARTHQUAKE_MOCK_INTERVAL_MINUTES=15

# --- Historial (backfill on-demand) ---
# Cuando el frontend consulta un rango de fechas pasado que no está en la
# base, el backend descarga el historial del USGS (FDSN) y lo guarda.
# Colombia: magnitud >= 2.5 · Mundo: magnitud >= 4.5 · máx. 60 días por consulta.
EARTHQUAKE_BACKFILL_ENABLED=true

# --- Logs ---
LOG_LEVEL=info
# pretty para desarrollo, json para producción
LOG_FORMAT=pretty
